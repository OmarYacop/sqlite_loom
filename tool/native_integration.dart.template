import 'package:flutter_test/flutter_test.dart';
import 'package:integration_test/integration_test.dart';
import 'package:sqflite/sqflite.dart';
import 'package:sqlite_loom/sqlite_loom.dart';

final class Rows extends DbTable<({int id, String value}), int> {
  const Rows();
  static final id = integer('id');
  static final value = text('value');
  static final parent = integer('parent');
  @override
  String get tableName => 'rows';
  @override
  DbColumn<int> get primaryKey => id;
  @override
  Iterable<AnyDbColumn> get columns => [id, value, parent];
  @override
  ({int id, String value}) decode(DbRow row) => (id: row.get(id), value: row.get(value));
  @override
  DbValues encode(({int id, String value}) row) => DbValues.fromAssignments([id.set(row.id), value.set(row.value)]);
  @override
  int keyOf(({int id, String value}) row) => row.id;
}

void main() {
  IntegrationTestWidgetsFlutterBinding.ensureInitialized();
  testWidgets('native file persistence, invalidation, transactions and reopening', (tester) async {
    final path = '${await getDatabasesPath()}/loom_native_contract.db';
    await deleteDatabase(path);
    final raw = await openDatabase(path);
    await raw.execute('CREATE TABLE rows(id INTEGER PRIMARY KEY, value TEXT NOT NULL, parent INTEGER NOT NULL DEFAULT 1)');
    final events = <DbObservation>[];
    var db = SqliteLoom(raw, observer: events.add);
    try {
      await db.configure(writeAheadLogging: true);
      final change = db.changes.first;
      await db.table(const Rows()).insert((id: 0, value: 'zero'));
      expect((await change).isNotEmpty, isTrue);
      await db.transaction((tx) async {
        await tx.table(const Rows()).insertAll([
          for (var id = 1; id <= 2000; id++) (id: id, value: 'value${id % 7}'),
        ], batchSize: 100);
        await expectLater(tx.savepoint((nested) async {
          await nested.table(const Rows()).whereKey(0).delete();
          throw StateError('rollback savepoint');
        }), throwsStateError);
      });
      expect(events.where((event) => event.operation == 'batch').length, 20);
      expect(events.where((event) => event.operation == 'batch').every((event) => event.transactionId != null), isTrue);
      expect(await db.table(const Rows()).count(), 2001);
      await expectLater(db.transaction((tx) async {
        await tx.table(const Rows()).allRows().delete();
        throw StateError('rollback transaction');
      }), throwsStateError);
      final validation = await DbSchema(raw).validate([const Rows()], requireAllColumns: true);
      expect(validation.isValid, isTrue);
      final feed = DbMergedRelationships<({int id, String value}), int, int>([
        for (final first in [true, false]) dbMergedRelationshipSource(
          relationship: DbHasMany<({int id, String value}), int, ({int id, String value}), int>(
            parent: const Rows(), children: const Rows(), foreignKey: Rows.parent, foreignKeyOf: (_) => 1),
          cursorColumn: Rows.value, convert: (row) => row.id,
          transform: (query) => query.where(first ? Rows.id.lessThan(1000) : Rows.id.greaterThanOrEquals(1000)),
        ),
      ]);
      final expected = (await feed.loadKeys(db, [1], limit: 3000))[1]!;
      final loaded = <int>[];
      DbMergedContinuation? cursor;
      do {
        final page = await feed.loadPage(db, 1, limit: 100, cursor: cursor);
        loaded.addAll(page.items);
        cursor = page.nextCursor;
        expect(loaded.length, lessThanOrEqualTo(2001));
      } while (cursor != null);
      expect(loaded, expected);
      final capabilities = await db.capabilities();
      if (capabilities.supports(DbFeature.returning)) {
        expect((await db.table(const Rows()).insertReturning((id: 2001, value: 'returning'))).id, 2001);
      }
      await db.close();
      db = SqliteLoom(await openDatabase(path));
      expect((await db.table(const Rows()).find(0))!.value, 'zero');
      expect(await db.table(const Rows()).count(), greaterThanOrEqualTo(2001));
    } finally {
      await db.close();
      await deleteDatabase(path);
    }
  });
}
