#!/usr/bin/env sh
# Run the native contract against a caller-selected Flutter device.
# The generated host app and all build products stay outside this repository.
set -eu
if [ "$#" -ne 1 ]; then
  echo 'Usage: ./tool/native-ci <flutter-device-id>' >&2
  exit 64
fi
repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
harness=$(mktemp -d "${TMPDIR:-/tmp}/loom-native.XXXXXX")
echo "Native harness: $harness"
flutter create --no-pub --project-name loom_native --platforms=ios,android,macos "$harness"
cat > "$harness/pubspec.yaml" <<PUBSPEC
name: loom_native
version: 1.0.0+1
environment:
  sdk: '>=3.12.0 <4.0.0'
dependencies:
  flutter:
    sdk: flutter
  sqflite: ^2.4.2
  sqlite_loom:
    path: '$repository_root'
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
PUBSPEC
mkdir -p "$harness/integration_test"
cp "$repository_root/tool/native_integration.dart.template" "$harness/integration_test/persistence_test.dart"
cd "$harness"
flutter pub get
flutter test integration_test/persistence_test.dart -d "$1"
